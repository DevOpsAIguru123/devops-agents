SONAR_ORGANIZATION=REPLACE_ME_WITH_SONARQUBE_CLOUD_ORGANIZATION_KEY
SONAR_TOKEN=REPLACE_ME_WITH_SONARQUBE_PROJECT_TOKEN
DOCKERHUB_USERNAME=REPLACE_ME_WITH_DOCKERHUB_USERNAME
DOCKERHUB_REPOSITORY=agentic-devops-portfolio
DOCKERHUB_TOKEN=REPLACE_ME_WITH_DOCKERHUB_ACCESS_TOKEN
GOOGLE_API_KEY=REPLACE_ME_WITH_GEMINI_API_KEY
